{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketforge.dev/schemas/menu-page.schema.json",
  "title": "PocketForge menu page document",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "root", "pages"],
  "properties": {
    "format": { "const": "pocketforge.menu/1" },
    "id": { "$ref": "#/$defs/id" },
    "root": { "$ref": "#/$defs/id" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "msg": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "args": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": { "text": { "type": "string" } }
        }
      ]
    },
    "cond": {
      "oneOf": [
        { "enum": ["always", "never"] },
        { "type": "object", "additionalProperties": false, "required": ["when"], "properties": { "when": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["unless"], "properties": { "unless": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["all"], "properties": { "all": { "type": "array", "items": { "$ref": "#/$defs/cond" } } } },
        { "type": "object", "additionalProperties": false, "required": ["any"], "properties": { "any": { "type": "array", "items": { "$ref": "#/$defs/cond" } } } }
      ]
    },
    "bind": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["pref"], "properties": { "pref": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["option"], "properties": { "option": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["host"], "properties": { "host": { "$ref": "#/$defs/id" } } }
      ]
    },
    "confirm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "confirm_label"],
      "properties": {
        "title": { "$ref": "#/$defs/msg" },
        "body": { "$ref": "#/$defs/msg" },
        "confirm_label": { "$ref": "#/$defs/msg" },
        "destructive": { "type": "boolean" }
      }
    },
    "choiceOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string" },
        "label": { "$ref": "#/$defs/msg" },
        "detail": { "$ref": "#/$defs/msg" }
      }
    },
    "itemCommon": {
      "type": "object",
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string" },
        "label": { "$ref": "#/$defs/msg" },
        "subtitle": { "$ref": "#/$defs/msg" },
        "icon": { "$ref": "#/$defs/id" },
        "enabled": { "$ref": "#/$defs/cond" },
        "visible": { "$ref": "#/$defs/cond" },
        "a11y": { "$ref": "#/$defs/msg" }
      }
    },
    "action": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        { "type": "object", "properties": { "kind": { "const": "action" }, "confirm": { "$ref": "#/$defs/confirm" }, "stay_open": { "type": "boolean" } } }
      ],
      "unevaluatedProperties": false
    },
    "toggle": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        { "type": "object", "required": ["bind"], "properties": { "kind": { "const": "toggle" }, "bind": { "$ref": "#/$defs/bind" } } }
      ],
      "unevaluatedProperties": false
    },
    "choice": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        { "type": "object", "required": ["bind", "options"], "properties": { "kind": { "const": "choice" }, "bind": { "$ref": "#/$defs/bind" }, "options": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/choiceOption" } }, "present": { "enum": ["inline", "picker"] } } }
      ],
      "unevaluatedProperties": false
    },
    "stepper": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        { "type": "object", "required": ["bind", "min", "max"], "properties": { "kind": { "const": "stepper" }, "bind": { "$ref": "#/$defs/bind" }, "min": { "type": "integer" }, "max": { "type": "integer" }, "step": { "type": "integer", "minimum": 1 }, "unit": { "$ref": "#/$defs/msg" } } }
      ],
      "unevaluatedProperties": false
    },
    "info": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        { "type": "object", "properties": { "kind": { "const": "info" }, "value": { "$ref": "#/$defs/msg" }, "bind": { "$ref": "#/$defs/bind" } } }
      ],
      "unevaluatedProperties": false
    },
    "slider": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        { "type": "object", "required": ["bind", "min", "max"], "properties": { "kind": { "const": "slider" }, "bind": { "$ref": "#/$defs/bind" }, "min": { "type": "integer" }, "max": { "type": "integer" }, "step": { "type": "integer", "minimum": 1 } } }
      ],
      "unevaluatedProperties": false
    },
    "text": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        { "type": "object", "required": ["bind", "max_chars"], "properties": { "kind": { "const": "text" }, "bind": { "$ref": "#/$defs/bind" }, "purpose": { "enum": ["normal", "name", "number", "pin", "email", "url", "search"] }, "max_chars": { "type": "integer", "minimum": 1 }, "secret": { "type": "boolean" } } }
      ],
      "unevaluatedProperties": false
    },
    "link": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        { "type": "object", "required": ["page"], "properties": { "kind": { "const": "link" }, "page": { "$ref": "#/$defs/id" } } }
      ],
      "unevaluatedProperties": false
    },
    "progress": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        { "type": "object", "required": ["bind"], "properties": { "kind": { "const": "progress" }, "bind": { "$ref": "#/$defs/bind" }, "indeterminate": { "type": "boolean" } } }
      ],
      "unevaluatedProperties": false
    },
    "binding": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        { "type": "object", "required": ["context", "action"], "properties": { "kind": { "const": "binding" }, "context": { "$ref": "#/$defs/id" }, "action": { "$ref": "#/$defs/id" } } }
      ],
      "unevaluatedProperties": false
    },
    "dateTime": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        { "type": "object", "required": ["bind"], "properties": { "kind": { "const": "date_time" }, "bind": { "$ref": "#/$defs/bind" }, "fields": { "enum": ["date", "time", "date_time"] } } }
      ],
      "unevaluatedProperties": false
    },
    "custom": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        { "type": "object", "required": ["renderer"], "properties": { "kind": { "const": "custom" }, "renderer": { "$ref": "#/$defs/id" } } }
      ],
      "unevaluatedProperties": false
    },
    "item": {
      "oneOf": [
        { "$ref": "#/$defs/action" }, { "$ref": "#/$defs/toggle" },
        { "$ref": "#/$defs/choice" }, { "$ref": "#/$defs/stepper" },
        { "$ref": "#/$defs/info" }, { "$ref": "#/$defs/slider" },
        { "$ref": "#/$defs/text" }, { "$ref": "#/$defs/link" },
        { "$ref": "#/$defs/progress" }, { "$ref": "#/$defs/binding" },
        { "$ref": "#/$defs/dateTime" }, { "$ref": "#/$defs/custom" }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "header": { "$ref": "#/$defs/msg" },
        "footer": { "$ref": "#/$defs/msg" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "sections"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/msg" },
        "tabs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "primary": { "$ref": "#/$defs/id" },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
      }
    }
  }
}
