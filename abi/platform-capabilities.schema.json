{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketforge.dev/schemas/platform-capabilities.schema.json",
  "title": "PocketForge platform capability contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_family",
    "runtime_abi",
    "platform_version",
    "supported_capabilities"
  ],
  "properties": {
    "schema_version": {
      "enum": [1, 2]
    },
    "runtime_family": {
      "type": "string",
      "pattern": "^pocketforge/[a-z0-9-]+$"
    },
    "runtime_abi": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "platform_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "supported_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "accelerometer",
          "audio",
          "entropy",
          "gnss",
          "gyroscope",
          "imu",
          "input",
          "leds",
          "location",
          "magnetometer",
          "menu",
          "options",
          "pointer",
          "rumble",
          "settings",
          "vibration"
        ]
      }
    },
    "physical_memory_mib": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "app_memory_budget_mib": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "gles_max": {
      "type": "string",
      "enum": ["2.0", "3.0", "3.1", "3.2"]
    },
    "vulkan_max": {
      "type": "string",
      "enum": ["1.0", "1.1", "1.2", "1.3", "1.4"]
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "buttons",
          "dpad",
          "stick",
          "two_sticks",
          "touch",
          "keyboard",
          "pointer"
        ]
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["schema_version"],
        "properties": { "schema_version": { "const": 1 } }
      },
      "then": {
        "properties": {
          "physical_memory_mib": false,
          "app_memory_budget_mib": false,
          "gles_max": false,
          "vulkan_max": false,
          "inputs": false,
          "display": false
        }
      }
    },
    {
      "if": {
        "required": ["schema_version"],
        "properties": { "schema_version": { "const": 2 } }
      },
      "then": {
        "required": [
          "physical_memory_mib",
          "app_memory_budget_mib",
          "inputs",
          "display"
        ]
      }
    }
  ]
}
